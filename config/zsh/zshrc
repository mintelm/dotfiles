# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# WSL: use windows git inside windows dirs (much faster there)
if [[ -r /proc/version ]] && grep -qi microsoft /proc/version; then
    function isWinDir { [[ $(pwd -P) == /mnt/[cd]/* ]] }
    function git {
        if isWinDir; then
            git.exe "$@"
        else
            command git "$@"
        fi
    }
fi

# general
path+=(~/.local/bin)
fpath+=(~/.zsh)
set -o emacs
export GPG_TTY=$TTY # for pinentry
function title() {
    print -Pn -- "\e]2;%(!.@@@ .)%c\a"
}
autoload -Uz add-zsh-hook
add-zsh-hook -Uz precmd title

# history settings
HISTFILE=~/.cache/zsh_history
HISTSIZE=50000
SAVEHIST=10000
setopt appendhistory
setopt sharehistory
setopt histfcntllock
setopt histignorealldups

# source it up
source ~/.zsh/aliases.zsh
source ~/.zsh/keybinds.zsh
source ~/.zsh/lsd.zsh
source ~/.zsh/fzf-tab.zsh
source ~/.zsh/completion.zsh # runs compinit, must come before plugins
source ~/.zsh/manydots-magic.zsh
[[ ! -f ~/.zsh/local.zsh ]] || source ~/.zsh/local.zsh

# plugins (generated by nix); syntax-highlighting must be loaded last
source ~/.zsh/plugins.zsh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.zsh/p10k.zsh ]] || source ~/.zsh/p10k.zsh
